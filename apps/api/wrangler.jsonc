{
  // معسكر نقلة — one Worker serves the web app (static assets) and the API under /api.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "transfer-camp",
  "main": "src/index.js",
  "compatibility_date": "2025-06-01",
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "camp",
      "database_id": "8d01c33c-e5c7-4187-afd3-726c82b7adc9",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
